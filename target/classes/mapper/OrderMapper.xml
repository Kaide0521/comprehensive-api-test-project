<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.assettest.mapper.OrderMapper">
    <resultMap id="OrderEntityResultMap" type="com.example.assettest.entity.OrderEntity">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="owner_user_id" property="ownerUserId"/>
        <result column="customer_name" property="customerName"/>
        <result column="status" property="status"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="paid_at" property="paidAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="BaseOrderColumns">
        id, order_id, tenant_id, owner_user_id, customer_name, status,
        total_amount, paid_at, created_at, updated_at, deleted
    </sql>

    <select id="selectOrderEntity" resultMap="OrderEntityResultMap">
        select <include refid="BaseOrderColumns"/>
        from orders
        where tenant_id = #{tenantId}
          and order_id = #{orderId}
          and deleted = false
    </select>

    <select id="searchOrders" resultMap="OrderEntityResultMap">
        select <include refid="BaseOrderColumns"/>
        from orders
        where tenant_id = #{condition.tenantId}
        <if test="condition.userId != null">
          and owner_user_id = #{condition.userId}
        </if>
        <if test="condition.status != null">
          and status = #{condition.status}
        </if>
        order by created_at desc
    </select>

    <select id="selectOrderAttributes" resultType="map">
        select attribute_key, attribute_value
        from order_attributes
        where order_id = #{orderId}
    </select>
</mapper>
